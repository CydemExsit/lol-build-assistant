{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LoL Build Assistant: Serve UI",
      "type": "shell",
      "command": "python -m src.main serve",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "LoL Build Assistant: Tests",
      "type": "shell",
      "command": "python -B -m pytest -q -p no:cacheprovider",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "LoL Build Assistant: Cleanup Preview",
      "type": "shell",
      "command": "python -m src.main cleanup",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
